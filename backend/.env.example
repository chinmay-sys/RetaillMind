# Database
DATABASE_URL=sqlite:///./retailmind.db

# Security & JWT — DO NOT use this in production.
# Generate a secure key with: python -c "import secrets; print(secrets.token_hex(32))"
# SECRET_KEY=<auto-generated if not set>
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Models (Optional — template-based responses active by default)
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_google_gemini_api_key_here

# Qdrant Vector Store (Optional)
QDRANT_HOST=localhost
QDRANT_PORT=6333
